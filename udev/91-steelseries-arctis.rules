ACTION=="remove", GOTO="local_end"

# Arctis 7+
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="220e", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="220e", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis 7+ (PS5)
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2212", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2212", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis 7+ (XBOX)
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2216", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2216", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis 7+ (Destiny)
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2236", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2236", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis Nova Pro Wireless
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="12e0", MODE="0666"
KERNEL=="event*", SUBSYSTEM=="input", SUBSYSTEMS=="usb", ATTRS{idProduct}=="12e0", ATTRS{idVendor}=="1038", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis Nova Pro Wireless X
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="12e5", MODE="0666"
KERNEL=="event*", SUBSYSTEM=="input", SUBSYSTEMS=="usb", ATTRS{idProduct}=="12e5", ATTRS{idVendor}=="1038", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis Nova 7
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2202", MODE="0666"
KERNEL=="event*", SUBSYSTEM=="input", SUBSYSTEMS=="usb", ATTRS{idProduct}=="2202", ATTRS{idVendor}=="1038", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis Nova 7 X
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2206", MODE="0666"
KERNEL=="event*", SUBSYSTEM=="input", SUBSYSTEMS=="usb", ATTRS{idProduct}=="2206", ATTRS{idVendor}=="1038", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis Nova 7 X_v2
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2258", MODE="0666"
KERNEL=="event*", SUBSYSTEM=="input", SUBSYSTEMS=="usb", ATTRS{idProduct}=="2258", ATTRS{idVendor}=="1038", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis Nova 7 P
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="220a", MODE="0666"
KERNEL=="event*", SUBSYSTEM=="input", SUBSYSTEMS=="usb", ATTRS{idProduct}=="220a", ATTRS{idVendor}=="1038", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"

# Arctis Nova 7 Diablo IV
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="223a", MODE="0666"
KERNEL=="event*", SUBSYSTEM=="input", SUBSYSTEMS=="usb", ATTRS{idProduct}=="223a", ATTRS{idVendor}=="1038", TAG+="symlink", SYMLINK+="steelseries/arctis", TAG+="systemd"


# Grant user access to SteelSeries Arctis Nova 7 (1038:2202) control interfaces (If the software doesn't work with the rules above, try creating similar rule for your device as the one below)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2202", MODE="0666"

LABEL="local_end"
